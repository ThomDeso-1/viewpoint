# Copy this file to .env and fill in what you have. Everything here is
# optional at startup — the app walks you through Setup/Onboarding in the
# browser and writes credentials into .env for you (see server/services/env-config.ts).
# This file just documents what ends up there.

# ── Server ──
PORT=3000
DATA_DIR=./data

# Sets the login password directly (bypasses the stored hash in SQLite —
# see server/platform/auth.ts). Leave unset to set a password from the
# Setup screen on first run instead.
# APP_PASSWORD=

# ── Transport security ──
# Set TRUST_PROXY=1 only when a reverse proxy (deploy/Caddyfile, nginx)
# terminates HTTPS in front of the app — it lets req.secure follow
# X-Forwarded-Proto and marks the session cookie Secure. With no proxy,
# leave it unset: a direct client could otherwise forge X-Forwarded-*.
# TRUST_PROXY=1

# The app's public HTTPS URL, if it has one. Used only as a signal that
# HTTPS is set up (see the PHI start-guard in server/platform/phi-guard.ts).
# APP_PUBLIC_URL=https://your-host

# Escape hatch for the PHI start-guard: the server refuses to boot over
# plain HTTP once OHIP is not in mock mode, or once any patient record
# exists. Set to 1 to override — LAN testing only, never with real
# patients. Every boot then prints a loud warning.
# ALLOW_INSECURE_PHI=1

# ── Encryption at rest ──
# Generated automatically on first use and written here — you do not set
# this yourself. It encrypts health card numbers, stored OAuth tokens, and
# OHIP responses (server/services/crypto.ts).
#
# Back this up alongside your database: data/ without this key cannot be
# decrypted. Replacing it makes every existing encrypted value unreadable.
DATA_ENCRYPTION_KEY=

# ── Claude (receipt extraction) ──
# From https://console.anthropic.com/ — or set later from Settings in the app.
CLAUDE_API_KEY=

# ── Wave (expense upload) ──
# Set from the onboarding wizard / Settings screen in the app, which fetches
# your businesses/accounts/sales-taxes and fills these in for you.
WAVE_ACCESS_TOKEN=
WAVE_BUSINESS_ID=
WAVE_BUSINESS_NAME=
WAVE_EXPENSE_ACCOUNT_ID=
WAVE_ANCHOR_ACCOUNT_ID=
WAVE_SALES_TAX_ID=

# ── Wave: invoicing (exam requests) ──
# Which account new invoices post income to, and optionally a saved
# product to use as the invoice line item. Set one of these — invoices
# need a line item — from the Settings screen.
WAVE_INCOME_ACCOUNT_ID=
WAVE_SERVICE_PRODUCT_ID=

# Default fee used when drafting an exam invoice, in dollars.
EXAM_FEE_AMOUNT=

# ── Wave: OAuth (optional) ──
# "token" (default) uses WAVE_ACCESS_TOKEN above and needs nothing else.
# "oauth" needs the client below, a Wave Pro subscription on the connected
# business, and an HTTPS redirect URI.
WAVE_AUTH_MODE=token
WAVE_CLIENT_ID=
WAVE_CLIENT_SECRET=
# WAVE_REDIRECT_URI=https://your-host/api/wave/callback

# ── Google (Gmail + Calendar) ──
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com and add the redirect URI shown on the
# Settings screen. Google permits http://localhost, so connect from a
# browser on the machine running the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Which calendar to read. "primary" unless you keep a separate one.
GOOGLE_CALENDAR_ID=primary

# The Gmail search identifying exam requests — a label is the most
# reliable (e.g. "label:exam-requests"). Nothing is polled until this is
# set. Anything matching is sent to Claude for extraction, so keep it tight.
GMAIL_EXAM_REQUEST_QUERY=

# Extractions below this confidence (0–1) are held for manual review
# instead of being drafted. Default 0.6.
EXAM_REQUEST_MIN_CONFIDENCE=0.6

# ── Reminders ──
# Your business name (e.g. Viewpoint Vision Care) — appears in the
# signature line of reminder emails sent to patients.
BUSINESS_NAME=
BUSINESS_TIMEZONE=America/Toronto
# How far ahead of the appointment to send the reminder. Default 24.
REMINDER_LEAD_HOURS=24

# ── OHIP Health Card Validation ──
# "mock" (default) returns simulated results, clearly labelled as such
# everywhere they appear. Switch to "conformance" only once the ministry
# has issued conformance credentials, and to "production" only after
# passing conformance testing.
OHIP_HCV_MODE=mock

# Ministry credentials. Required only when OHIP_HCV_MODE is not "mock".
# Node cannot read a PKCS#12 keystore, so convert yours to PEM once:
#   openssl pkcs12 -in testStore.p12 -nocerts -nodes -out ohip-key.pem
#   openssl pkcs12 -in testStore.p12 -clcerts -nokeys -out ohip-cert.pem
OHIP_PRIVATE_KEY_PATH=
OHIP_CERTIFICATE_PATH=
OHIP_CA_CERT_PATH=
OHIP_USERNAME=
OHIP_PASSWORD=
OHIP_MOH_ID=
OHIP_CONFORMANCE_KEY=
# OHIP_ENDPOINT=
