# Copy this file to .env and fill in what you have. Everything here is
# optional at startup — the app walks you through Setup/Onboarding in the
# browser and writes credentials into .env for you (see server/services/env-config.ts).
# This file just documents what ends up there.

# ── Server ──
PORT=3000
DATA_DIR=./data

# Sets the login password directly (bypasses the stored hash in SQLite —
# see server/middleware/auth.ts). Leave unset to set a password from the
# Setup screen on first run instead.
# APP_PASSWORD=

# ── Claude (receipt extraction) ──
# From https://console.anthropic.com/ — or set later from Settings in the app.
CLAUDE_API_KEY=

# ── Wave (expense upload) ──
# Set from the onboarding wizard / Settings screen in the app, which fetches
# your businesses/accounts/sales-taxes and fills these in for you.
WAVE_ACCESS_TOKEN=
WAVE_BUSINESS_ID=
WAVE_BUSINESS_NAME=
WAVE_EXPENSE_ACCOUNT_ID=
WAVE_ANCHOR_ACCOUNT_ID=
WAVE_SALES_TAX_ID=
