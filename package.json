{
  "name": "viewpoint-receipts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npx vite --host 0.0.0.0",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npx vite build",
    "build": "npm run build:client",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "cd client && npm test",
    "test:all": "npm test && npm run test:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "cd client && tsc -b --noEmit",
    "typecheck:all": "npm run typecheck && npm run typecheck:client",
    "demo": "concurrently -n mock,server,client -c magenta,blue,green \"npm run demo:mock\" \"npm run demo:server\" \"npm run demo:client\"",
    "demo:mock": "tsx demo/mock-server.ts",
    "demo:server": "npm run demo:seed && DEMO_MODE=1 DATA_DIR=./demo-data ENV_FILE=./demo-data/.env tsx watch server/index.ts",
    "demo:client": "cd client && npx vite --host 0.0.0.0",
    "demo:seed": "DEMO_MODE=1 DATA_DIR=./demo-data ENV_FILE=./demo-data/.env tsx demo/seed.ts",
    "demo:reset": "rm -rf ./demo-data && npm run demo:seed"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  }
}
